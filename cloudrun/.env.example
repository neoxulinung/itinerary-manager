LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# Optional: a LINE user ID allowed to end/force-end any trip, bypassing the normal
# "only the person who started it can end it" rule. Leave unset to disable the override.
ADMIN_USER_ID=

# Same Cloudflare account/database as the Workers deployment (worker/wrangler.jsonc.example) -
# this is the same D1 database, just accessed over its REST API instead of a Workers binding,
# since Cloud Run isn't a Workers runtime. No data migration needed if replatforming an existing
# Workers deployment - same tables, same rows, just a different access method.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=<your-d1-database-id>
# Generate from the Cloudflare dashboard: My Profile -> API Tokens -> Create Token
# (permission: D1:Edit, scoped to your database). The Workers D1 binding never needs one of
# these - this is only required for REST API access from outside a Workers runtime.
CF_API_TOKEN=

# Same R2 bucket as the Workers deployment (itinerary-manager-photos in wrangler.jsonc.example) -
# public access must be enabled (Cloudflare dashboard -> your bucket -> Settings -> Public
# access) the same way the Workers deployment needs it. Only the S3-compatible API credentials
# are new: Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create API token (permission:
# Object Read & Write, scoped to your bucket).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=<your-r2-bucket-name>
R2_PUBLIC_BASE_URL=<your-r2-public-base-url>

LIFF_ID=<your-liff-id>
# Shared secret Cloud Scheduler must send as the x-scheduler-secret header on
# /internal/scheduled-organize. Generate any random string, e.g. `openssl rand -hex 32`.
SCHEDULER_SECRET=
