ANTHROPIC_API_KEY=sk-ant-...
LINE_CHANNEL_SECRET=...
LINE_CHANNEL_ACCESS_TOKEN=...
# Optional: a LINE user ID allowed to end/force-end any trip, bypassing the normal
# "only the person who started it can end it" rule. Leave unset to disable the override.
ADMIN_USER_ID=U...
# Optional: only needed if you want /模型 to be able to switch a stage to an OpenAI model
# (gpt5 / gpt5mini). Leave unset to disable those two aliases.
OPENAI_API_KEY=sk-...
